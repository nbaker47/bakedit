        "element.hover": "#1b1a23",
        "element.active": "#82aaff50",
        "element.selected": "#82aaff38",
        "ghost_element.hover": "#1b1a23",
        "ghost_element.active": "#82aaff50",
        "ghost_element.selected": "#82aaff38",
        "terminal.background": "#12101a",
        "terminal.foreground": "#f8f8f2",
        "terminal.bright_foreground": "#f8f8f2",
        "players": [
          {
            "cursor": "#82aaff",
            "background": "#82aaff",
            "selection": "#82aaff40"
          }
        ],
        "syntax": {
          "keyword": {
            "color": "#ff00ff"
          },
          "string": {
            "color": "#50fa7b"
          },
          "comment": {
            "color": "#768d8d",
            "font_style": "italic"
          },
          "function": {
            "color": "#82aaff"
          },
          "type": {
            "color": "#f1fa8c"
          },
          "number": {
            "color": "#ff6363"
          },
          "boolean": {
            "color": "#ff6363"
          },
          "constant": {
            "color": "#80ffea"
          },
          "property": {
            "color": "#80ffea"
          },
          "operator": {
            "color": "#80ffea"
          },
          "variable": {
            "color": "#f8f8f2"
          },
          "punctuation": {
            "color": "#f8f8f2"
          },
          "tag": {
            "color": "#82aaff"
          },
          "attribute": {
            "color": "#f1fa8c"
          },
          "constructor": {
            "color": "#f1fa8c"
          },
          "title": {
            "color": "#82aaff",
            "font_weight": 700
          },
          "link_uri": {
            "color": "#80ffea"
          },
          "emphasis": {
            "color": "#ff00ff"
          },
          "string.escape": {
            "color": "#80ffea"
          }
        },
        "terminal.ansi.black": "#12101a",
        "terminal.ansi.bright_black": "#768d8d",
        "terminal.ansi.red": "#ff6363",
        "terminal.ansi.bright_red": "#ff8787",
        "terminal.ansi.green": "#50fa7b",
        "terminal.ansi.bright_green": "#86fba8",
        "terminal.ansi.yellow": "#f1fa8c",
        "terminal.ansi.bright_yellow": "#ffffa5",
        "terminal.ansi.blue": "#82aaff",
        "terminal.ansi.bright_blue": "#82b1ff",
        "terminal.ansi.magenta": "#ff00ff",
        "terminal.ansi.bright_magenta": "#ff69ff",
        "terminal.ansi.cyan": "#80ffea",
        "terminal.ansi.bright_cyan": "#5fffff",
        "terminal.ansi.white": "#f8f8f2",
        "terminal.ansi.bright_white": "#ffffff"
