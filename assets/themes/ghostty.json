{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Ghostty",
  "author": "dotfiles, generated from Ghostty theme SilkCircuit Neon",
  "themes": [
    {
      "name": "Ghostty",
      "appearance": "dark",
      "style": {
        "background": "#12101a",
        "surface.background": "#12101a",
        "elevated_surface.background": "#25232c",
        "editor.background": "#12101a",
        "editor.gutter.background": "#12101a",
        "editor.active_line.background": "#1b1a23",
        "editor.foreground": "#f8f8f2",
        "editor.line_number": "#768d8d",
        "editor.active_line_number": "#f8f8f2",
        "panel.background": "#12101a",
        "title_bar.background": "#12101a",
        "title_bar.inactive_background": "#12101a",
        "status_bar.background": "#12101a",
        "toolbar.background": "#12101a",
        "tab_bar.background": "#12101a",
        "tab.active_background": "#1b1a23",
        "tab.inactive_background": "#12101a",
        "scrollbar.track.background": "#12101a",
        "scrollbar.thumb.background": "#25232c",
        "border": "#25232c",
        "border.variant": "#1b1a23",
        "border.focused": "#82aaff",
        "border.selected": "#82aaff",
        "panel.focused_border": "#82aaff",
        "text": "#f8f8f2",
        "text.muted": "#768d8d",
        "icon": "#f8f8f2",
