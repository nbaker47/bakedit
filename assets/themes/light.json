{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Light",
  "author": "bakedit (Catppuccin Latte light palette)",
  "themes": [
    {
      "name": "Light",
      "appearance": "light",
      "style": {
        "background": "#eff1f5",
        "surface.background": "#e6e9ef",
        "elevated_surface.background": "#dce0e8",
        "editor.background": "#eff1f5",
        "editor.gutter.background": "#eff1f5",
        "editor.active_line.background": "#e6e9ef",
        "editor.foreground": "#4c4f69",
        "editor.line_number": "#9ca0b0",
        "editor.active_line_number": "#4c4f69",
        "panel.background": "#e6e9ef",
        "title_bar.background": "#dce0e8",
        "title_bar.inactive_background": "#dce0e8",
        "status_bar.background": "#e6e9ef",
        "toolbar.background": "#eff1f5",
        "tab_bar.background": "#e6e9ef",
        "tab.active_background": "#eff1f5",
        "tab.inactive_background": "#e6e9ef",
        "scrollbar.track.background": "#eff1f5",
        "scrollbar.thumb.background": "#bcc0cc",
        "border": "#ccd0da",
        "border.variant": "#dce0e8",
        "border.focused": "#1e66f5",
        "border.selected": "#1e66f5",
        "panel.focused_border": "#1e66f5",
        "text": "#4c4f69",
        "text.muted": "#6c6f85",
        "text.placeholder": "#8c8fa1",
        "text.accent": "#1e66f5",
        "icon": "#4c4f69",
        "icon.muted": "#6c6f85",
        "element.hover": "#dce0e8",
        "element.active": "#1e66f535",
        "element.selected": "#1e66f526",
        "ghost_element.hover": "#dce0e8",
        "ghost_element.active": "#1e66f535",
        "ghost_element.selected": "#1e66f526",
        "terminal.background": "#eff1f5",
        "terminal.foreground": "#4c4f69",
        "terminal.bright_foreground": "#2c2f44",
        "players": [
          {
            "cursor": "#dc8a78",
            "background": "#1e66f5",
            "selection": "#1e66f533"
          }
        ],
        "syntax": {
          "keyword": { "color": "#8839ef" },
          "string": { "color": "#40a02b" },
          "comment": { "color": "#8c8fa1", "font_style": "italic" },
          "function": { "color": "#1e66f5" },
          "type": { "color": "#df8e1d" },
          "number": { "color": "#fe640b" },
          "boolean": { "color": "#fe640b" },
          "constant": { "color": "#fe640b" },
          "property": { "color": "#04a5e5" },
          "operator": { "color": "#04a5e5" },
          "variable": { "color": "#4c4f69" },
          "punctuation": { "color": "#6c6f85" },
          "tag": { "color": "#1e66f5" },
          "attribute": { "color": "#df8e1d" },
          "constructor": { "color": "#df8e1d" },
          "title": { "color": "#1e66f5", "font_weight": 700 },
          "link_uri": { "color": "#179299" },
          "emphasis": { "color": "#d20f39", "font_style": "italic" },
          "string.escape": { "color": "#ea76cb" }
        },
        "terminal.ansi.black": "#5c5f77",
        "terminal.ansi.bright_black": "#6c6f85",
        "terminal.ansi.red": "#d20f39",
        "terminal.ansi.bright_red": "#d20f39",
        "terminal.ansi.green": "#40a02b",
        "terminal.ansi.bright_green": "#40a02b",
        "terminal.ansi.yellow": "#df8e1d",
        "terminal.ansi.bright_yellow": "#df8e1d",
        "terminal.ansi.blue": "#1e66f5",
        "terminal.ansi.bright_blue": "#1e66f5",
        "terminal.ansi.magenta": "#ea76cb",
        "terminal.ansi.bright_magenta": "#ea76cb",
        "terminal.ansi.cyan": "#179299",
        "terminal.ansi.bright_cyan": "#179299",
        "terminal.ansi.white": "#acb0be",
        "terminal.ansi.bright_white": "#bcc0cc"
      }
    }
  ]
}
