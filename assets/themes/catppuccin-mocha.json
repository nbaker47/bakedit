{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Catppuccin Mocha",
  "author": "bakedit (Catppuccin Mocha palette)",
  "themes": [
    {
      "name": "Catppuccin Mocha",
      "appearance": "dark",
      "style": {
        "background": "#1e1e2e",
        "surface.background": "#181825",
        "elevated_surface.background": "#313244",
        "editor.background": "#1e1e2e",
        "editor.gutter.background": "#1e1e2e",
        "editor.active_line.background": "#262637",
        "editor.foreground": "#cdd6f4",
        "editor.line_number": "#6c7086",
        "editor.active_line_number": "#cdd6f4",
        "panel.background": "#181825",
        "title_bar.background": "#11111b",
        "title_bar.inactive_background": "#11111b",
        "status_bar.background": "#181825",
        "toolbar.background": "#1e1e2e",
        "tab_bar.background": "#181825",
        "tab.active_background": "#1e1e2e",
        "tab.inactive_background": "#181825",
        "scrollbar.track.background": "#1e1e2e",
        "scrollbar.thumb.background": "#45475a",
        "border": "#313244",
        "border.variant": "#262637",
        "border.focused": "#cba6f7",
        "border.selected": "#cba6f7",
        "panel.focused_border": "#cba6f7",
        "text": "#cdd6f4",
        "text.muted": "#a6adc8",
        "text.placeholder": "#6c7086",
        "text.accent": "#cba6f7",
        "icon": "#cdd6f4",
        "icon.muted": "#a6adc8",
        "element.hover": "#313244",
        "element.active": "#cba6f745",
        "element.selected": "#cba6f733",
        "ghost_element.hover": "#313244",
        "ghost_element.active": "#cba6f745",
        "ghost_element.selected": "#cba6f733",
        "terminal.background": "#1e1e2e",
        "terminal.foreground": "#cdd6f4",
        "terminal.bright_foreground": "#ffffff",
        "players": [
          {
            "cursor": "#f5e0dc",
            "background": "#cba6f7",
            "selection": "#585b7066"
          }
        ],
        "syntax": {
          "keyword": { "color": "#cba6f7" },
          "string": { "color": "#a6e3a1" },
          "comment": { "color": "#6c7086", "font_style": "italic" },
          "function": { "color": "#89b4fa" },
          "type": { "color": "#f9e2af" },
          "number": { "color": "#fab387" },
          "boolean": { "color": "#fab387" },
          "constant": { "color": "#fab387" },
          "property": { "color": "#89dceb" },
          "operator": { "color": "#89dceb" },
          "variable": { "color": "#cdd6f4" },
          "punctuation": { "color": "#9399b2" },
          "tag": { "color": "#89b4fa" },
          "attribute": { "color": "#f9e2af" },
          "constructor": { "color": "#f9e2af" },
          "title": { "color": "#89b4fa", "font_weight": 700 },
          "link_uri": { "color": "#94e2d5" },
          "emphasis": { "color": "#f38ba8", "font_style": "italic" },
          "string.escape": { "color": "#f5c2e7" }
        },
        "terminal.ansi.black": "#45475a",
        "terminal.ansi.bright_black": "#585b70",
        "terminal.ansi.red": "#f38ba8",
        "terminal.ansi.bright_red": "#f38ba8",
        "terminal.ansi.green": "#a6e3a1",
        "terminal.ansi.bright_green": "#a6e3a1",
        "terminal.ansi.yellow": "#f9e2af",
        "terminal.ansi.bright_yellow": "#f9e2af",
        "terminal.ansi.blue": "#89b4fa",
        "terminal.ansi.bright_blue": "#89b4fa",
        "terminal.ansi.magenta": "#f5c2e7",
        "terminal.ansi.bright_magenta": "#f5c2e7",
        "terminal.ansi.cyan": "#94e2d5",
        "terminal.ansi.bright_cyan": "#94e2d5",
        "terminal.ansi.white": "#bac2de",
        "terminal.ansi.bright_white": "#a6adc8"
      }
    }
  ]
}
