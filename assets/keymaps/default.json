      "ctrl-alt-g": ["action::Sequence", ["git::Diff", "workspace::ToggleZoom"]],
      "ctrl-e": "workspace::FocusCenterPane",
      "ctrl-alt-e": ["action::Sequence", ["project_panel::ToggleFocus", "project_panel::ScrollCursorCenter"]],
      "ctrl-shift-e": ["action::Sequence", ["project_panel::ToggleFocus", "project_panel::ScrollCursorCenter"]],
      "ctrl-alt-shift-e": "project_panel::SwapPosition",
      "ctrl-f": ["terminal::SendText", "\u0002[/"],
      "ctrl-alt-f": ["terminal::SendText", "\u0002[/"],
      "ctrl-shift-f": ["terminal::SendText", "\u0002[/"],
      "ctrl-p": "file_finder::Toggle",
      "ctrl-alt-p": "command_palette::Toggle",
      "ctrl-shift-p": "command_palette::Toggle",
      "cmd-alt-left": "pane::ActivatePreviousItem",
      "cmd-alt-right": "pane::ActivateNextItem",
      "cmd-alt-1": ["pane::ActivateItem", 0],
      "cmd-alt-2": ["pane::ActivateItem", 1],
      "cmd-alt-3": ["pane::ActivateItem", 2],
      "cmd-alt-4": ["pane::ActivateItem", 3],
      "cmd-alt-5": ["pane::ActivateItem", 4],
      "cmd-alt-6": ["pane::ActivateItem", 5],
      "cmd-alt-7": ["pane::ActivateItem", 6],
      "cmd-alt-8": ["pane::ActivateItem", 7],
      "cmd-alt-9": ["pane::ActivateItem", 8],
      "ctrl-{": "pane::ActivatePreviousItem",
      "ctrl-}": "pane::ActivateNextItem",
      "ctrl-alt-[": "pane::ActivatePreviousItem",
      "ctrl-alt-]": "pane::ActivateNextItem"
    }
  },
  // Global font zoom (no context so it wins over Pane's ctrl--/ctrl-0 and works in Terminal too).
  {
    "bindings": {
      "ctrl-=": "bakedit::ZoomIn",
      "ctrl-+": "bakedit::ZoomIn",
      "ctrl--": "bakedit::ZoomOut",
      "ctrl-0": "bakedit::ZoomReset"
    }
  }
]
