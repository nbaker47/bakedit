  // ─────────────────────────────────────────────────────────────────────────────────────
  // 2. Nathan's bindings (from ~/.config/zed/keymap.json)
  // ─────────────────────────────────────────────────────────────────────────────────────

  // Panels: cmd-<letter> shows a panel, cmd-alt-<letter> is its fullscreen form.
  //   cmd-j        terminal            cmd-alt-j   terminal, fullscreen
  //   cmd-g        git panel           cmd-alt-g   project diff, fullscreen
  //   cmd-shift-e  file tree (closes it when pressed inside the tree)
  //   cmd-e        the editor          cmd-alt-e   the editor, all docks hidden
  //   cmd-alt-f    fullscreen whatever has the focus (editor: hide all docks; terminal: zoom)
  {
    "context": "Workspace",
    "bindings": {
      "cmd-j": "terminal_panel::Toggle",
      // In Zed this is workspace::ToggleZoom, which from the editor loses to a default
      // binding (close other tabs). Here it always means "the terminal, fullscreen".
      "cmd-alt-j": "terminal_panel::ToggleZoom",
      "cmd-g": "git_panel::Toggle",
      "cmd-alt-g": ["action::Sequence", ["git::Diff", "workspace::ToggleZoom"]],
      "cmd-shift-e": ["action::Sequence", ["project_panel::ToggleFocus", "project_panel::ScrollCursorCenter"]],
      "cmd-e": "workspace::FocusCenterPane",
      "cmd-alt-f": "workspace::ToggleAllDocks",
      "cmd-alt-e": ["action::Sequence", ["workspace::FocusCenterPane", "workspace::ToggleAllDocks"]]
    }
  },
  {
    "context": "Editor || Pane",
    "bindings": {
      "cmd-alt-j": "terminal_panel::ToggleZoom",
      "cmd-g": "git_panel::Toggle",
      "cmd-alt-g": ["action::Sequence", ["git::Diff", "workspace::ToggleZoom"]],
      "cmd-shift-e": "pane::RevealInProjectPanel",
      "cmd-e": "workspace::FocusCenterPane",
      "cmd-alt-f": "workspace::ToggleAllDocks",
      "cmd-alt-e": ["action::Sequence", ["workspace::FocusCenterPane", "workspace::ToggleAllDocks"]]
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-alt-j": "workspace::ToggleZoom",
      "cmd-g": "git_panel::Toggle",
      "cmd-alt-g": ["action::Sequence", ["git::Diff", "workspace::ToggleZoom"]],
      "cmd-shift-e": ["action::Sequence", ["project_panel::ToggleFocus", "project_panel::ScrollCursorCenter"]],
      "cmd-e": "workspace::FocusCenterPane",
      "cmd-alt-f": "workspace::ToggleZoom",
      "cmd-alt-e": ["action::Sequence", ["workspace::FocusCenterPane", "workspace::ToggleAllDocks"]]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // Copy a GitHub permalink to the current line or selection.
      "ctrl-alt-g": "editor::CopyPermalinkToLine",
      // cmd-up/down jump 5 lines instead of going to the start/end of the file.
      "cmd-up": ["editor::MoveUpByLines", { "lines": 5 }],
      "cmd-down": ["editor::MoveDownByLines", { "lines": 5 }],
      "cmd-shift-up": ["editor::SelectUpByLines", { "lines": 5 }],
      "cmd-shift-down": ["editor::SelectDownByLines", { "lines": 5 }],
      // cmd-k + delimiter: select the text inside the enclosing pair (again to grow to the
      // next pair out), or jump inside the first pair in the file.
      "cmd-k (": ["editor::SelectBetween", { "kind": "paren" }],
      "cmd-k )": ["editor::SelectBetween", { "kind": "paren" }],
      "cmd-k [": ["editor::SelectBetween", { "kind": "bracket" }],
      "cmd-k ]": ["editor::SelectBetween", { "kind": "bracket" }],
      "cmd-k {": ["editor::SelectBetween", { "kind": "brace" }],
      "cmd-k }": ["editor::SelectBetween", { "kind": "brace" }],
      "cmd-k \"": ["editor::SelectBetween", { "kind": "dquote" }],
      "cmd-k '": ["editor::SelectBetween", { "kind": "squote" }],
      "cmd-k `": ["editor::SelectBetween", { "kind": "backtick" }],
      "cmd-k <": ["editor::SelectBetween", { "kind": "angle" }],
      "cmd-k >": ["editor::SelectBetween", { "kind": "angle" }]
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "cmd-shift-e": "workspace::CloseActiveDock",
      "cmd-k 0": "project_panel::CollapseAllEntries",
      "cmd-k cmd-0": "project_panel::CollapseAllEntries",
      "space": "project_panel::Open",
      "up": "menu::SelectPrevious",
      "down": "menu::SelectNext",
      "cmd-up": ["menu::SelectPrevious", { "lines": 5 }],
      "cmd-down": ["menu::SelectNext", { "lines": 5 }],
      "enter": "project_panel::OpenPermanent"
    }
  },
  // Arrowing through the changes shows each file's diff and reveals it in the tree, while
  // the focus stays in the list.
  {
    "context": "GitPanel && ChangesList",
    "bindings": {
      "down": [
        "action::Sequence",
        ["menu::SelectNext", "menu::Confirm", "pane::RevealInProjectPanel", "git_panel::FocusChanges"]
      ],
      "up": [
        "action::Sequence",
        ["menu::SelectPrevious", "menu::Confirm", "pane::RevealInProjectPanel", "git_panel::FocusChanges"]
      ]
    }
  },

  // ─────────────────────────────────────────────────────────────────────────────────────
  // 3. Nav mode and edit mode
  // ─────────────────────────────────────────────────────────────────────────────────────
  // With "vim_mode": true the editor opens in nav mode, where no plain key changes the text:
  // letters, digits, space and the other text keys type nothing (they are swallowed
  // quietly), and enter, tab, backspace and delete do nothing either, nor do their emacs
  // ctrl aliases (ctrl-h, ctrl-d, ctrl-w, ctrl-k, ctrl-y, ctrl-t). Everything else works as
  // in edit mode, the cursor included (it goes past the end of a line as edit mode's does):
  // the arrows and the ; nav layer move, shift-arrows select, and the cmd and alt shortcuts
  // above do what they always do, so saving and the pickers work, and so do the ones that
  // edit on purpose (cmd-x, cmd-v and a terminal paste, cmd-z, cmd-backspace,
  // alt-backspace, cmd-enter). There are no vim letter keys, operators, counts, registers
  // or : commands. cmd-i switches between the two (so do ctrl-] i, in any terminal, and a
  // click on the mode in the status bar), the cursor and any selection kept; escape also
  // leaves edit mode, and in nav mode it only lets go of a selection. With the modes off cmd-i turns them on, as
  // bakedit::ToggleEditMode does (settings.json is left alone). From the find bar it switches
  // the text's mode and the bar keeps the keys.
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-i": "bakedit::ToggleMode"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "cmd-i": "bakedit::ToggleMode"
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == insert",
    "bindings": {
      "escape": "vim::NormalBefore"
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == normal",
    "bindings": {
      "escape": "editor::Cancel",
      "y": "editor::Copy",
      "shift-y": "editor::Copy",
      // The plain keys that edit, and their emacs ctrl aliases: off in nav mode (null, so a
      // key nobody takes is dropped). A legacy terminal sends ctrl-h for backspace.
      "enter": null,
      "shift-enter": null,
      "tab": null,
      "shift-tab": null,
      "backspace": null,
      "shift-backspace": null,
      "delete": null,
      "ctrl-h": null,
      "ctrl-d": null,
      "ctrl-w": null,
      "ctrl-k": null,
      "ctrl-y": null,
      "ctrl-t": null
    }
  },

  // ─────────────────────────────────────────────────────────────────────────────────────
  // 4. bakedit extras
  // ─────────────────────────────────────────────────────────────────────────────────────

  // herdr, when it runs in the terminal panel. These are the chords that used to live in
  // Zed's keymap as ctrl-b sequences typed into the terminal.
  //   cmd-alt-arrows         focus the pane that way; at the edge hop tab (left/right) or workspace (up/down)
  //   cmd-alt-shift-arrows   move the focused pane
  //   ctrl-alt-cmd-up/down   previous / next workspace
  //   cmd-alt-1..9           workspace 1..9
  //   cmd-alt-z              zoom the pane          cmd-alt-c   collapse it
  //   cmd-alt-a              expand it to 90%
  //   shift-up/down          scroll the pane 3 lines        cmd-shift-up/down   9 lines
  {
    "context": "Terminal",
    "bindings": {
      "cmd-alt-left": ["herdr::Navigate", "left"],
      "cmd-alt-right": ["herdr::Navigate", "right"],
      "cmd-alt-up": ["herdr::Navigate", "up"],
      "cmd-alt-down": ["herdr::Navigate", "down"],
      "cmd-alt-shift-left": ["herdr::MovePane", "left"],
      "cmd-alt-shift-right": ["herdr::MovePane", "right"],
      "cmd-alt-shift-up": ["herdr::MovePane", "up"],
      "cmd-alt-shift-down": ["herdr::MovePane", "down"],
      "ctrl-alt-cmd-up": "herdr::PreviousWorkspace",
      "ctrl-alt-cmd-down": "herdr::NextWorkspace",
      "cmd-alt-1": ["herdr::FocusWorkspace", 1],
      "cmd-alt-2": ["herdr::FocusWorkspace", 2],
      "cmd-alt-3": ["herdr::FocusWorkspace", 3],
      "cmd-alt-4": ["herdr::FocusWorkspace", 4],
      "cmd-alt-5": ["herdr::FocusWorkspace", 5],
      "cmd-alt-6": ["herdr::FocusWorkspace", 6],
      "cmd-alt-7": ["herdr::FocusWorkspace", 7],
      "cmd-alt-8": ["herdr::FocusWorkspace", 8],
      "cmd-alt-9": ["herdr::FocusWorkspace", 9],
      "cmd-alt-z": "herdr::ToggleZoom",
      "cmd-alt-c": "herdr::ToggleCollapse",
      "cmd-alt-a": "herdr::ToggleExpand",
      "shift-up": ["herdr::Scroll", { "direction": "up", "lines": 3 }],
      "shift-down": ["herdr::Scroll", { "direction": "down", "lines": 3 }],
      "cmd-shift-up": ["herdr::Scroll", { "direction": "up", "lines": 9 }],
      "cmd-shift-down": ["herdr::Scroll", { "direction": "down", "lines": 9 }],
      // Pick a file path or URL shown in the terminal and open it, without the mouse.
      "cmd-o": "terminal::OpenLinks",
      // Enter herdr copy mode and start searching scrollback.
      "cmd-f": ["terminal::SendText", "\u0002[/"]
    }
