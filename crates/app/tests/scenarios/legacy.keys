# bakedit in a terminal without the kitty keyboard protocol (ptyshot --legacy answers only
# the device attributes): no cmd keys, no key releases. The status bar says so, the nav
# layer is off, and ctrl-] is the prefix that reaches bakedit.

wait 2.5
snap start

# ctrl-] t: the terminal takes the keyboard.
key ctrl-]
key t
wait 0.5
snap terminal

# ctrl-] c: back to the centre. ctrl-] p: the file finder.
key ctrl-]
key c
key ctrl-]
key p
wait 0.5
text lib
wait 0.5
snap finder
key enter
wait 1.5
snap editor

# ctrl-] on its own: after a pause, everything it can be followed by.
key ctrl-]
wait 1.2
snap chord
key escape
wait 0.3

# ctrl-] q quits.
key ctrl-]
key q
wait 1
