// The editor settings from Nathan's ~/.config/zed/settings.json that bakedit reads (the
// docks, modes, saving and theme), so the scenarios run bakedit set up the way he runs it.
// run.sh puts this file at $XDG_CONFIG_HOME/zed/settings.json in its scratch folder.
{
  "terminal": {
    "dock": "left",
    "max_scroll_history_lines": 10000,
    "font_size": 12
  },
  "git_panel": {
    "dock": "left",
    "default_width": 627
  },
  "project_panel": {
    "dock": "right",
    "default_width": 249,
    "auto_fold_dirs": false
  },
  "minimap": {
    "show": "always"
  },
  "autosave": "on_focus_change",
  "colorize_brackets": true,
  "auto_indent_on_paste": false,
  "use_on_type_format": false,
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "base_keymap": "VSCode",
  "vim_mode": true,
  "restore_on_startup": "last_session",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ghostty"
  },
  "theme_overrides": {
    "Ghostty": {
      "panel.focused_border": "#82aaff",
      "element.active": "#82aaff55",
      "element.selected": "#82aaff45",
      "ghost_element.active": "#82aaff55",
      "ghost_element.selected": "#82aaff45"
    }
  }
}
